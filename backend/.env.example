APP_ENV=dev
APP_SECRET=change_this_to_a_random_32_char_string
DEFAULT_URI=http://localhost:8000
DATABASE_URL="postgresql://optifleet:secret@db:5432/optifleet?serverVersion=16&charset=utf8"
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_this_passphrase
JWT_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Développement : aucun envoi réel. Production : renseigner un vrai transport SMTP.
MAILER_DSN=null://null
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_FROM_ADDRESS=noreply@optifleet.fr
MAILER_FROM_NAME="OptiFleet"
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
